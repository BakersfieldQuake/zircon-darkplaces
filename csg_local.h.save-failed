// for_each_brush (brushnum, d_ent, d_brush)
// for_each_end // for_each_brush
#define for_each_brush_maxcount2(YOUR_BRUSHNUM_N, D_ENT, D_BRUSH, MAXCOUNT)\
	for (int YOUR_BRUSHNUM_N = 0; YOUR_BRUSHNUM_N < MAXCOUNT; YOUR_BRUSHNUM_N ++) { \
		brush_s *D_BRUSH = &D_ENT->brushlist.brush[YOUR_BRUSHNUM_N]; \
		if (D_BRUSH->is_considered_deleted) continue; \
		if (D_BRUSH->is_a_patch) continue; /*PATCH, SKIP*/ \
		if (D_BRUSH->brushrowlist.count == 0) continue;


// for_each_brush_const2 (brushnum, d_brush, hm, entnum)
// for_each_end // for_each_brush
#define for_each_brush_const2(YOUR_BRUSHNUM_N, D_BRUSH, HM, ENTNUM)\
	for (int YOUR_BRUSHNUM_N = 0; YOUR_BRUSHNUM_N < BRUSH_COUNT(HM, ENTNUM); YOUR_BRUSHNUM_N ++) { \
		const brush_s *D_BRUSH = ENT_GET(HM, ENTNUM).brushlist.brush[YOUR_BRUSHNUM_N]; \
		if (D_BRUSH->is_considered_deleted) continue; \
		if (D_BRUSH->is_a_patch) continue; /*PATCH, SKIP*/ \
		if (D_BRUSH->brushrowlist.count == 0) continue;

