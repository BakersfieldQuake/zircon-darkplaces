#define CSGM_START_					int _num_done = 0;
#define CSGM_END_					zpr ("%s processed", MYKEY); return _num_done;
#define CSGM_END_FUNC_				zpr ("%s processed", __func__); return _num_done;
#define CSGM_END_RETURN_ONLY_		return _num_done;
#define CSGM_ENT_STAMP_DONE_		map_key_delete (hm, entnum, MYKEY); _num_done ++; // STAMP
#define CSGM_ENT_STAMP_NO_DONE_		map_key_delete (hm, entnum, MYKEY); // STAMP
#define CSGM_KEY_DELETE_WORLD_		map_key_delete (hm, WORLD_0, MYKEY);

// CSGM_KEY_DEFINE_WORLD_OR_ABORT_0 (_rename, MYKEY);
#define CSGM_KEY_DEFINE_WORLD_OR_ABORT_0(_VAR, KEYNAME) \
	ccs *_VAR = map_get(hm, WORLD_0, MYKEY); \
	if (_VAR == NULL) return 0


#define CSGM_NUM_DONE_PLUS_			_num_done ++;
#define CSGM_NUM_DONE_PLUS_EQ(X)	_num_done += (X);

#define TARGETNAMES_EXTRA_NULL		NULL

typedef struct {
	ccs				*text_start;
	ccs				*datasrc;
	int				depth;

	map_t			*plist;
	entityx_s		*p_ent;
	brush_s			*p_brush;
	brushrow_s		*p_brushrow;
	patchrow_s		*p_patchrow;
} map_reader_s;


#define Q3MAP_PRE(MYSTRING,MYFUNC,EXAMPLE,DESCRIBE,WORLD_OR_ENTITY_TYPE,APPLIES_TO) \
	while (String_Contains (sinza, MYSTRING)) { \
		map_t list_map1 = {0}; /* pac.map */ \
		Con_PrintLinef ("Found " MYSTRING " in .map, checking ..."); \
		/* PARSE THE MAP */ \
		int isok = map_load_from_string (&list_map1, sinza); \
		if (isok == false) Perform_Exit_1_Error("map_load_from_string failed"); \
		/*int num_made = entitylist_perform_brush_remove_texture (&list_map1, timestring_newval);*/ \
		int num_done = MYFUNC(&list_map1, MYSTRING); \
		printvari (num_done); \
		/* RE-WRITE IF ANYTHING HAPPENED */ \
		if (num_done) { \
			CSG_REWRITE_RELOAD_ \
		} /* actions performed so rewrite*/ \
		map_close	(&list_map1); \
		break; \
	} /* while */ // Ender

#define Q3MAP_PRX(MYSTRING,MYFUNC,EXAMPLE,DESCRIBE,WORLD_OR_ENTITY_TYPE,APPLIES_TO) \
	while (String_Contains (sinza, MYSTRING)) { \
		map_t list_map1 = {0}; /* pac.map */ \
		Con_PrintLinef ("Found " MYSTRING " in .map, checking ..."); \
		/* PARSE THE MAP */ \
		int isok = map_load_from_string (&list_map1, sinza); \
		if (isok == false) Perform_Exit_1_Error("map_load_from_string failed"); \
		/*int num_made = entitylist_perform_brush_remove_texture (&list_map1, timestring_newval);*/ \
		int num_done = MYFUNC(&list_map1, MYSTRING, mappath); \
		printvari (num_done); \
		/* RE-WRITE IF ANYTHING HAPPENED */ \
		if (num_done) { \
			CSG_REWRITE_RELOAD_ \
		} /* actions performed so rewrite*/ \
		map_close	(&list_map1); \
		break; \
	} /* while */ // Ender

