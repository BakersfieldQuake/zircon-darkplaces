	for (int YOUR_BRUSHNUM_N = 0; YOUR_BRUSHNUM_N < D_ENT->brushlist.count; YOUR_BRUSHNUM_N ++) { \
		brush_s *D_BRUSH = &D_ENT->brushlist.brush[YOUR_BRUSHNUM_N]; \
