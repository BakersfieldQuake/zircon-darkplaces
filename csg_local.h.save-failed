// for_each_face2 (facenum, r_face, hm, entnum, brushnum)
// for_each_end // face
#define for_each_brush_face2(YOUR_FACENUM_N, D_FACE, HM, ENTNUM, BRUSHNUM)\
	for (int YOUR_FACENUM_N = 0; YOUR_FACENUM_N < FACE_COUNT(HM, ENTNUM, BRUSHNUM); YOUR_FACENUM_N ++) { \
		brushrow_s *D_FACE = FACE_GET(HM, ENTNUM, BRUSHNUM, YOUR_FACENUM_N); // Ender

// for_each_face_with_texture_2 (facenum, d_face, hm, entnum, brushnum, texturename)
// for_each_end // face
#define for_each_face_with_texture_2(YOUR_FACENUM_N, D_FACE, HM, ENTNUM, BRUSHNUM, TEXTURENAME)\
	for (int YOUR_FACENUM_N = 0; YOUR_FACENUM_N < FACE_COUNT(HM, ENTNUM, BRUSHNUM); YOUR_FACENUM_N ++) { \
		brushrow_s *D_FACE = FACE_GET(HM, ENTNUM, BRUSHNUM, YOUR_FACENUM_N); \
		if (String_Match(D_FACE->pbrtexture, TEXTURENAME) == false) continue;


// for_each_brush2 (brushnum, d_brush, hm, entnum)
// for_each_end // for_each_brush
#define for_each_brush2(YOUR_BRUSHNUM_N, D_BRUSH, HM, ENTNUM)\
	for (int YOUR_BRUSHNUM_N = 0; YOUR_BRUSHNUM_N < BRUSH_COUNT(HM, ENTNUM); YOUR_BRUSHNUM_N ++) { \
		brush_s *D_BRUSH = BRUSH_GET(HM, ENTNUM, YOUR_BRUSHNUM_N); \
		if (D_BRUSH->is_considered_deleted) continue; \
		if (D_BRUSH->is_a_patch) continue;


// for_each_brush_or_patch2 (brushnum, d_brush, hm, entnum)
// for_each_end // for_each_brush
#define for_each_brush_or_patch2(YOUR_BRUSHNUM_N, D_BRUSH, HM, ENTNUM)\
	for (int YOUR_BRUSHNUM_N = 0; YOUR_BRUSHNUM_N < BRUSH_COUNT(HM, ENTNUM); YOUR_BRUSHNUM_N ++) { \
		brush_s *D_BRUSH = ENT_GET(HM, ENTNUM).brushlist.brush[YOUR_BRUSHNUM_N]; \
		if (D_BRUSH->is_considered_deleted) continue;

