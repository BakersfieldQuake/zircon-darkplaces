CALLERS_ (map_load_from_string) // EXCLUSIVE - WE ARE BOSS
RELATED_ (map_metric_entity_sub map_metric_reset)

void map_metric_all (map_t *plist) // METRIC CALLS US - MEGA MAJOR
{
	int num_processed = 0;

	GET_WORLD_0 (plist, d_world);

	qbool was_processed = map_metric_entity_sub (d_world); // Returns false if no brushes.
	d_world->is_world_or_func_group = true;

	// We could be dealing with something weird like all func groups.
	if (was_processed)
		num_processed ++;

	vec3_t bbemins, bbemaxs;
	VectorCopyDestSrc (bbemins, d_world->bemins);
	VectorCopyDestSrc (bbemaxs, d_world->bemaxs);

	qbool did_any_ents = false;
	for_each_entity_after_world_undeleted (entnum, plist, d_ent)
	//for_each_world_func_group (entnum, plist, d_ent)
		ccs *classname = map_get_classname (plist, entnum);
		if (String_Starts_With_Nullproof(classname, "func_group"))
			d_ent->is_world_or_func_group = true;

		qbool was_processed2 = map_metric_entity_sub (d_ent);
		if (!was_processed2)
			continue;

		// EXPANDING ENTITY METRIC
		bounds_expand	(d_ent->bemins, bbemins, bbemaxs); // Yes, bbemaxs is what expands
		bounds_expand	(d_ent->bemaxs, bbemins, bbemaxs);

		did_any_ents = true;
		num_processed ++;
	for_each_end // for_each_entity  entities that are "func_wall"

	if (1 /*did_any_ents*/) {
		// Could be all world and point entities -- no func_group and no walls/doors/etc.
		VectorCopyDestSrc	(plist->bbentsmins, bbemins);
		VectorCopyDestSrc	(plist->bbentsmaxs, bbemaxs);
		VectorSubtract		(plist->bbentsmaxs, plist->bbentsmins, plist->bbentsdims);
	} // if 1
}

void map_metric_reset (map_t *plist) // METRIC CALLS US - MEGA MAJOR
{
	//const vec3_t vectorzero = {0,0,0};

	//GET_WORLD_0 (plist, p_world);

	VectorClear	(plist->bbentsmins);
	VectorClear	(plist->bbentsmaxs);
	VectorClear	(plist->bbentsdims);

	for_each_entity_undeleted (entnnum, plist, d_ent)
		VectorClear (d_ent->bemins);
		VectorClear (d_ent->bemaxs);
		VectorClear (d_ent->bedims);
		d_ent->has_brushes = false;
		for_each_brush_not_a_patch (brushnum, d_ent, d_brush)
			VectorClear (d_brush->bxmins);
			VectorClear (d_brush->bxmaxs);
			VectorClear (d_brush->bxdims);
			VectorClear (d_brush->bxcenter);

			for_each_brush_face (facenum, d_brush, d_face)
				VectorClear (d_face->bfmins);
				VectorClear (d_face->bfmaxs);
				VectorClear (d_face->bfdims);
			for_each_end // face
		for_each_end // brush
	for_each_end // entity
}

