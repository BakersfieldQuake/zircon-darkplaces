	return isok;
}

qbool entitylist_parse_mapfile_is_ok (map_t *plist, ccs *filename)
{
	char *maptext_za = FS_LoadFileQuick (filename);
	if (!maptext_za)
		return false;

	int isok = map_load_from_string (plist, maptext_za);

failed:
	Mem_FreeNull_ (maptext_za);
	return isok;
}

