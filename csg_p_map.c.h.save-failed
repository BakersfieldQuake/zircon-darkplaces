qbool map_load_from_string (map_t *plist, ccs *txt)
{
	qbool isok = private_entitylist_parsemaptxt (plist, txt);
	if (!isok) return false;
	// metric
	map_metric_all			(plist);
	map_metric_cubeoid_mark (plist);

	for_each_entity_undeleted (entnum, plist, d_ent)
		d_ent->original_brush_count = d_ent->brushlist.count;
	for_each_end // for_each_entity

	return true;
}


