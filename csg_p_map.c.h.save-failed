CALLERS_ (csqc_delete_world_brushes_with_nondominant_texture, entitylist_perform_weld_num_done)
void stringlist_append_entity_textures (stringlist_t *plist, entityx_s *r_ent)
{
	for_each_brush (brushnum, r_ent, d_brush)
		for_each_brush_face (facenum, d_brush, d_face)
			stringlistappend (plist, d_face->pbrtexture);
		for_each_end // face
	for_each_end // brush
}

int map_fieldname_prefix (map_t *hm, ccs *fieldname, ccs *prefix) // door1 --> $PREFIX_door1
{
	int num_changed = 0;
	for_each_entity_undeleted (entnum, hm, d_ent)
		for_each_key_val_pair (keyidx, d_ent, key, val)
			if (false == String_Match (key, fieldname))
				continue;

			Z_StrDupf_Realloc (&d_ent->pairslist.strings[keyidx + 1], "%s%s", prefix, val);
			num_changed ++;
		for_each_end // key val pairs
	for_each_end // for_each_entity
	return num_changed;
}


ccs *map_get (const map_t *hm, int entnum, ccs *keyname)
{
	return entity_get(ITOE(hm, entnum), keyname); // SEPT12026PASS
}

qbool map_get_vec3 (const map_t *hm, int entnum, ccs *key, vec3_t vout)
{
	VectorClear (vout);

	ccs *sval = entity_get(ITOE(hm, entnum), key); // SEPT12026PASS
	if (sval) {
		Math_atov3 (sval, vout);
		return true;
	}

	return false;
}

int map_entity_find_start_after (map_t *hm, ccs *key, ccs *value, int start_after)
{
	for_each_entity_undeleted_start_after(entnum,hm,dent,start_after)
		ccs *this_value = map_get (hm, entnum, key);
		if (!this_value) continue; // Does not have a classname
		if (false == String_Match (this_value, value)) continue; // No match

		return entnum; // FOUND
	for_each_end
	return not_found_neg1;
}

CALLERS_ (csgw_nodes_build_this_track)
int map_entity_find_start_after_lowy (map_t *hm, ccs *find_classname, int start_after)
{
	//float best_x = 999999;
	float best_y = 999999;
	int best_idx = not_found_neg1;
	for_each_entity_undeleted_start_after(entnum,hm,dent,start_after)
		ccs *classname = map_get (hm, entnum, "classname");
		if (!classname || false == String_Match (classname, find_classname/* "node"*/))
			continue;
		// Now we need to find the next and previous.
		map_get_vec3_dest_macro_DEFINE_ (hm, entnum, origin);
		if (origin[1] < best_y) {
			best_y = origin[1];
			best_idx = entnum;
		}
	for_each_end
	return best_idx;
}

void map_move (map_t *hm, vec3_t move_amount)
{
	map_move_epairs_origin	(hm, move_amount);
	map_move_all_brushes_patches	(hm, move_amount); // Has texture scaling.
}

CALLERS_ (VM_map_append_map map_get)
void map_append_map (map_t *dst, map_t *src)
{
	map_world_brushes_patches_copy	(dst, src);	// no keys, just brushes.
	map_afterworld_copy				(dst, src);	// brushes and keys.
}

void map_append_map_with_move (map_t *dst_map, map_t *src_map, vec3_t translate_move)
{
	// Do we have a rotating door problem?  translate the origin and the brush, that's double.
	// The only way we can check is looking for common/origin texture name

	// If origin brush entity (per entity basis)
	// Do not translate the brushes.

	map_move_epairs_origin		(src_map, translate_move);
	map_move_all_brushes_patches		(src_map, translate_move);
	map_append_map				(dst_map, src_map);
}

// same classname and same targetname == nth
int map_get_nthness_classnametargetname(map_t *plist, int my_entnum)
{
	entityx_s *efind = &plist->entity[my_entnum];

	int nthness = 0;

	ccs *efind_classname = map_get (plist, my_entnum, "classname");
	if (!efind_classname) return not_found_neg1;

	ccs *efind_targetname = map_get (plist, my_entnum, "targetname");
	if (!efind_targetname) return not_found_neg1;

	for_each_entity_original_even_deleted_ones_startnum (entnum, plist, e, AFTER_WORLD_1)
		// REQUIRE CLASSNAME AND TARGETNAME MATCH
		if (false == map_get_does_match (plist, entnum, "classname", efind_classname)) continue;
		if (false == map_get_does_match (plist, entnum, "targetname", efind_targetname)) continue;

		nthness ++; // Number of ones that are same classname and targetname

		if (e == efind) {
			Con_PrintLinef ("Entity %d %s %s: nthness == %d", my_entnum, efind_classname, efind_targetname, nthness);
			return nthness;
		} // e == efind
	for_each_end // original entities even undeleted in .map

	Con_PrintLinef ("Entity %d %s %s: nthness == " CON_RED "NOT FOUND", my_entnum, efind_classname, efind_targetname);
	return not_found_neg1;
}

baker_string_s *map_save_to_string_bsalloc (map_t *plist)
{
//#pragma message ("Add a Zircon preprocess key to the worldspawn keys")
	//baker_string_s *bs_maptext = BakerString_Create_Malloc ("");
	baker_string_s *bs_maptext = BakerString_Create_Malloc_With_MegaBytes (100); // 100 MB

	for_each_entity_undeleted (entnum, plist, r_ent)
		// Print keys
		BakerString_CatLinef (bs_maptext, "{ // Entity %d", entnum);

		for_each_key_val_pair (keyidx, r_ent, key, val)
			// August 5 2026 - keys with name "" no longer write.  Considered deleted.
			if (key && key[0] == CHAR_NULL_0) continue; // map_key_delete: This is where it no longer saves.
			BakerString_CatLinef (bs_maptext, QUOTED_S " " QUOTED_S, key, val);
		for_each_end // key val pairs

		for_each_brush_undeleted (brushnum, r_ent, r_brush)
			BakerString_CatCFmt (bs_maptext, "{" NEWLINE);

			if (r_brush->is_a_patch == false) {
				// REAL BRUSH
				for_each_brush_face (facenum, r_brush, r_face)
					BakerString_CatCFmt (bs_maptext,
						"( " VECTOR3_G  " ) "
						"( " VECTOR3_G  " ) "
						"( " VECTOR3_G  " ) "
						" %s "
						"[ " VECTOR4_G " ] "
						"[ " VECTOR4_G " ] "
						VECTOR3_G,
						 VECTOR3_SEND(r_face->a),
						 VECTOR3_SEND(r_face->b),
						 VECTOR3_SEND(r_face->c),
						 r_face->pbrtexture,
						 VECTOR4_SEND(r_face->tex_axis_s),
						 VECTOR4_SEND(r_face->tex_axis_t),
						 VECTOR3_SEND(r_face->faceparms)
						 );

					// Any extras add a space
					for (int j = 3; j < r_face->trail_count; j ++) {
						BakerString_CatCFmt (bs_maptext, " " FLOAT_LOSSLESS_FORMAT, r_face->faceparms[j] );
					}
					BakerString_CatC (bs_maptext, NEWLINE);
				for_each_end // for_each_brush_face
			} else {
i_am_patch:
					BakerString_CatCFmt (bs_maptext, "patchDef2" NEWLINE);
					BakerString_CatCFmt (bs_maptext, "{" NEWLINE);
					// caves/3i_sand2
					BakerString_CatCFmt (bs_maptext, "%s" NEWLINE, r_brush->texture);
					// ( 9 3 0 0 0 )
					BakerString_CatCFmt (bs_maptext, "( " FLOAT_LOSSLESS_FORMAT " " FLOAT_LOSSLESS_FORMAT " " FLOAT_LOSSLESS_FORMAT " " FLOAT_LOSSLESS_FORMAT " " FLOAT_LOSSLESS_FORMAT " )" NEWLINE, r_brush->patch_rows, r_brush->patch_cols, r_brush->other3[0], r_brush->other3[1], r_brush->other3[2]);
					BakerString_CatCFmt (bs_maptext, "(" NEWLINE);

					for_each_const_patch_row (rownum, r_brush, r_patchrow)
						//patchrow_s *ppr = &p_brush->patchrowlist.patchrow[prow];
						BakerString_CatCFmt (bs_maptext, "( " NEWLINE);
						for_each_patch_column (columnnum, r_brush, r_patchrow)
							// These don't perfectly match J.A.C.K. output which has extra zeroes
							// in the decimal places sometimes.
							BakerString_CatCFmt (bs_maptext, "( %g %g %g %8g %8g )" NEWLINE,
								r_patchrow->flots[columnnum * 5 + 0],
								r_patchrow->flots[columnnum * 5 + 1],
								r_patchrow->flots[columnnum * 5 + 2],
								r_patchrow->flots[columnnum * 5 + 3],
								r_patchrow->flots[columnnum * 5 + 4]
							);
						for_each_end // patch_column
						BakerString_CatCFmt (bs_maptext, " )" NEWLINE);
					for_each_end // patch_row

					BakerString_CatCFmt (bs_maptext, ")" NEWLINE);
					BakerString_CatCFmt (bs_maptext, "}" NEWLINE);
			} // if patch not a brush

			BakerString_CatCFmt (bs_maptext, "}" NEWLINE);
		for_each_end // for_each_brush
		BakerString_CatCFmt (bs_maptext, "}" NEWLINE);
	for_each_end // for_each_entity
	return bs_maptext;
}


